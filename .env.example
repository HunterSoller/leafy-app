# Firestore: allow reads/writes on `groups/{groupId}` for saved weather coords
# (location_lat, location_lng, location_label, location_source). Keep plant rules unchanged.

# Optional: when running `vite` locally, set this to your `vercel dev` origin so /api/identify-plant resolves.
# VITE_API_URL=http://localhost:3000

# Vercel serverless only — add in Vercel Project → Environment Variables (not VITE_).
ANTHROPIC_API_KEY=
